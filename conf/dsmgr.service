[Unit]
Description=IARM Mgr Daemon DS MGR
Requires=iarmbusd.service
After=lighttpd.service iarmbusd.service sysmgr.service wpeframework-powermanager.service

[Service]
Type=notify
ExecStartPre=/bin/mkdir -p /opt/persistent/ds
ExecStartPre=/bin/sh -c '/bin/sh /usr/lib/ds-monitor.sh &'
ExecStart=/bin/sh -c '/usr/bin/dsMgrMain'
# Runs only after READY=1 is confirmed (Type=notify guarantee).
ExecStartPost=/bin/touch /tmp/dsmgr.ready
# Signal ds-monitor.sh to exit — faster than systemctl stop (no service overhead).
ExecStartPost=/bin/touch /tmp/dsmgr_monitor_stop
# TODO: confirm how /opt/.dsmgr_restart_count is removed in RDKv before enabling.
#ExecStartPost=/bin/rm -f /opt/.dsmgr_restart_count
# Signal monitor to stop if still running (flag checked on next poll).
ExecStop=/bin/touch /tmp/dsmgr_monitor_stop
ExecStopPost=/bin/sh /usr/lib/ds-reboot.sh

[Install]
WantedBy=multi-user.target
